{
  "name": "f95launcher",
  "version": "1.9.2",
  "author": {
    "name": "maxbaydi",
    "email": "maxbaydi@users.noreply.github.com"
  },
  "description": "F95Launcher: desktop library, installs, updates, and cloud save sync for F95 games",
  "main": "src/main.js",
  "usageStats": {
    "endpoint": "https://f95launcher-stats.maxbayqoor.workers.dev"
  },
  "scripts": {
    "start": "npm run build:ui && electron .",
    "f95launcher": "npm run build:ui && electron .",
    "build": "npm run build:ui && electron-builder --win --x64",
    "dev:css:watch": "postcss src/assets/css/tailwind.css -o src/assets/css/tailwind.output.css --watch",
    "dev:web": "npm run build:ui && node scripts/dev-serve.js",
    "dev": "npm run build:ui && concurrently -k -n css,renderer,electron,web -c cyan,yellow,magenta,green \"npm run dev:css:watch\" \"npm run dev:renderer:watch\" \"electron . --dev\" \"node scripts/dev-serve.js\"",
    "build:css": "postcss src/assets/css/tailwind.css -o src/assets/css/tailwind.output.css",
    "rebuild": "npx electron-rebuild --version=37.0.0",
    "structure": "node scripts/generate-structure.js > scripts/project-structure.txt",
    "publish": "npm run build:ui && electron-builder --win -p always",
    "format": "prettier --write src/**/*.{js,jsx,css} && prettier --write src/assets/**/*.{js,jsx,css}",
    "lint": "eslint src/main.js src/database.js \"src/main/**/*.js\" \"src/shared/**/*.js\" \"test/**/*.test.js\" scripts/check-mirrors.js scripts/check-mirrors-electron.js scripts/usage-stats.js \"stats-worker/src/**/*.js\"",
    "stats": "node scripts/usage-stats.js",
    "check:mirrors": "node scripts/check-mirrors.js",
    "check:mirrors:app": "electron scripts/check-mirrors-electron.js",
    "catalog:probe": "electron scripts/catalog-probe-electron.js",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit",
    "check:jsx": "node scripts/check-jsx.js",
    "screenshots": "npm run build:ui && node scripts/screenshots.js",
    "test": "node --test \"test/*.test.js\"",
    "ci:check": "npm run build:ui && npm run lint && npm run check:jsx && npm run typecheck && npm run test",
    "build:renderer": "node scripts/build-renderer.js",
    "build:ui": "npm run build:css && npm run build:renderer",
    "dev:renderer:watch": "node scripts/build-renderer.js --watch",
    "qa:ui": "npm run build:ui && node scripts/verify-ui.js",
    "check:package": "node scripts/check-packaged-ui.js"
  },
  "build": {
    "appId": "com.maxbaydi.f95launcher",
    "productName": "F95Launcher",
    "publish": {
      "provider": "github",
      "owner": "maxbaydi",
      "repo": "f95-game-zone-app",
      "releaseType": "release",
      "vPrefixedTagName": true
    },
    "files": [
      "src/main.js",
      "src/main/**/*",
      "src/database.js",
      "src/index.html",
      "src/settings.html",
      "src/scrollbar-reveal.js",
      "src/web-preview-api.js",
      "src/renderer.js",
      "src/App.jsx",
      "src/shared/**/*",
      "src/assets/**/*",
      "src/core/**/*",
      "src/core/scanners/**/*",
      "src/core/importer/**/*",
      "src/core/settings/**/*",
      "package.json",
      "node_modules/7zip-bin/**/*",
      "node_modules/sqlite3/**/*",
      "node_modules/node-7z/**/*",
      "node_modules/node-unrar-js/**/*",
      "!src/assets/vendor/babel/**/*"
    ],
    "asar": true,
    "nodeGypRebuild": false,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/assets/images/appicon.ico"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "perMachine": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup ${version}.${ext}",
      "include": "build/installer.nsh",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@npmcli/fs": "^3.1.0",
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.5.10",
    "axios": "^1.7.2",
    "electron-updater": "^6.6.2",
    "ini": "^5.0.0",
    "lru-cache": "^10.0.0",
    "lz4js": "^0.2.0",
    "node-7z": "^0.4.0",
    "node-unrar-js": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-infinite-scroll-component": "^6.1.0",
    "rimraf": "^4.0.0",
    "sharp": "^0.34.3",
    "sqlite3": "^5.0.2",
    "swiper": "^10.3.1"
  },
  "devDependencies": {
    "@babel/standalone": "^7.25.6",
    "@electron/rebuild": "^3.7.2",
    "@types/node": "^18.19.42",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "debug": "^4.3.4",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^8.57.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^10.1.0",
    "prettier": "3.6.2",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.5"
  }
}
