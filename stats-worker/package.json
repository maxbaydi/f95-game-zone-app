{
  "name": "f95launcher-stats",
  "private": true,
  "type": "module",
  "description": "Anonymous install and usage counter for F95Launcher (Cloudflare Worker + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute f95launcher-stats --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute f95launcher-stats --local --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
